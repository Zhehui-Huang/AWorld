{
    "mcpServers": {
      "search": {
        "command": "python",
        "args": [
          "-m",
          "examples.gaia.mcp_collections.tools.search"
        ],
        "env": {
          "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
          "GOOGLE_CSE_ID": "${GOOGLE_CSE_ID}"
        },
        "client_session_timeout_seconds": 9999.0
      }
    }
}
{
    "mcpServers": {
        "pdf": {
            "command": "python",
            "args": [
                "-m",
                "examples.gaia.agent_collections.pdf_agent.mcp_tools.pdf"
            ],
            "env": {
            },
            "client_session_timeout_seconds": 9999.0
        },
        "image": {
            "command": "python",
            "args": [
                "-m",
                "examples.gaia.agent_collections.pdf_agent.mcp_tools.image"
            ],
            "env": {
                "IMAGE_LLM_MODEL_NAME": "${IMAGE_LLM_MODEL_NAME}",
                "IMAGE_LLM_API_KEY": "${IMAGE_LLM_API_KEY}",
                "IMAGE_LLM_BASE_URL": "${IMAGE_LLM_BASE_URL}"
            },
            "client_session_timeout_seconds": 1000.0
        },
        "memory_tools": {
            "command": "python",
            "args": [
                "-m",
                "examples.gaia.mcp_collections.memory_tools"
            ],
            "env": {
            },
            "client_session_timeout_seconds": 9999.0
        }
    }
}
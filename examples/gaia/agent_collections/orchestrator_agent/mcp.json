{
    "mcpServers": {
      "orchestrator_agent": {
        "command": "python",
        "args": [
          "-m",
          "examples.gaia.agent_collections.orchestrator_agent.orchestrator_agent"
        ],
        "env": {
          "LLM_PROVIDER": "${LLM_PROVIDER}",
          "LLM_MODEL_NAME": "${LLM_MODEL_NAME}",
          "LLM_BASE_URL": "${LLM_BASE_URL}",
          "LLM_API_KEY": "${LLM_API_KEY}",
          "AWORLD_WORKSPACE": "${AWORLD_WORKSPACE}",
          "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
          "GOOGLE_CSE_ID": "${GOOGLE_CSE_ID}",
          "ORCHESTRATION_LEVEL": "0"
        },
        "client_session_timeout_seconds": 9999.0
      },
      "search_agent": {
        "command": "python",
        "args": [
          "-m",
          "examples.gaia.agent_collections.search_agent.search_agent"
        ],
        "env": {
          "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
          "GOOGLE_CSE_ID": "${GOOGLE_CSE_ID}",
          "LLM_PROVIDER": "${LLM_PROVIDER}",
          "LLM_MODEL_NAME": "${LLM_MODEL_NAME}",
          "LLM_BASE_URL": "${LLM_BASE_URL}",
          "LLM_API_KEY": "${LLM_API_KEY}",
          "AWORLD_WORKSPACE": "${AWORLD_WORKSPACE}"
        },
        "client_session_timeout_seconds": 9999.0
      },
      "pdf_agent": {
        "command": "python",
        "args": [
          "-m",
          "examples.gaia.agent_collections.pdf_agent.pdf_agent"
        ],
        "env": {
          "LLM_PROVIDER": "${LLM_PROVIDER}",
          "LLM_MODEL_NAME": "${LLM_MODEL_NAME}",
          "LLM_BASE_URL": "${LLM_BASE_URL}",
          "LLM_API_KEY": "${LLM_API_KEY}",
          "AWORLD_WORKSPACE": "${AWORLD_WORKSPACE}"
        },
        "client_session_timeout_seconds": 9999.0
      },
      "image_agent": {
        "command": "python",
        "args": [
          "-m",
          "examples.gaia.agent_collections.image_agent.image_agent"
        ],
        "env": {
          "LLM_PROVIDER": "${LLM_PROVIDER}",
          "LLM_MODEL_NAME": "${LLM_MODEL_NAME}",
          "LLM_BASE_URL": "${LLM_BASE_URL}",
          "LLM_API_KEY": "${LLM_API_KEY}",
          "AWORLD_WORKSPACE": "${AWORLD_WORKSPACE}"
        },
        "client_session_timeout_seconds": 9999.0
      },
      "memory_tools": {
        "command": "python",
        "args": [
          "-m",
          "examples.gaia.mcp_collections.memory_tools"
        ],
        "env": {
        },
        "client_session_timeout_seconds": 9999.0
      }
    }
  }
  
  
